// Jenkinsfile (MVP): GitHub push -> Jenkins build -> inject secret จาก OpenBao เป็น env var
// ใช้ HashiCorp Vault plugin (OpenBao = Vault API) — token มาจาก Jenkins credential ไม่ hardcode
//
// ต้องมีก่อนรัน:
//   1) ติดตั้ง plugin "HashiCorp Vault"
//   2) เพิ่ม credential id = 'openbao-token' (Vault Token / Secret text = "root")
pipeline {
  agent any
  triggers {
    pollSCM('* * * * *')   // poll GitHub ทุก 1 นาที
  }
  stages {
    stage('Checkout') {
      steps { checkout scm }
    }
    stage('Build') {
      steps {
        echo '🔨 building sample app...'
        sh 'ls -la app/'
      }
    }
    stage('Use secret from OpenBao') {
      steps {
        script {
          // ดึง secret จาก OpenBao มา map เป็น env var
          def secrets = [[
            path: 'secret/sample-app',        // KV v2 path (plugin เติม /data ให้เอง)
            engineVersion: 2,
            secretValues: [
              [envVar: 'DB_PASSWORD', vaultKey: 'db_password']
            ]
          ]]
          def configuration = [
            vaultUrl: 'http://openbao:8200',  // service name ใน compose network
            vaultCredentialId: 'openbao-token',
            engineVersion: 2
          ]
          withVault([configuration: configuration, vaultSecrets: secrets]) {
            // ในบล็อกนี้ $DB_PASSWORD คือ env var จริง (Jenkins จะ mask ค่าใน log ให้ ****)
            sh 'echo "DB_PASSWORD ถูก inject แล้ว (ความยาว: ${#DB_PASSWORD})"'
            // ตัวอย่างเอาไปใช้จริง เช่น: sh 'DB_PASSWORD=$DB_PASSWORD ./run-migration.sh'
          }
        }
      }
    }
  }
  post {
    success { echo '✅ pipeline ผ่าน — secret inject จาก OpenBao เป็น env var สำเร็จ' }
  }
}
