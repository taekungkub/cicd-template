// app/Jenkinsfile — sample-app (monorepo: fe = Vite+React, be = Node)
//
// Flow: Lint → Build → Test → Scan → Deploy (docker compose บน host เดียวกับ Jenkins)
// Shared steps จาก library กลาง (vars/): trivyScan, sonarScan, withOpenBao
// Secret: OpenBao path secret/sample-app/<TARGET_ENV>
@Library('cicd-template@main') _

pipeline {
  agent any

  triggers { pollSCM('* * * * *') }
  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    // TODO: branch-based ต้องเป็น Multibranch job → env.BRANCH_NAME == 'main' ? 'prod' : 'staging'
    TARGET_ENV = 'prod'
  }

  stages {
    // check อย่างเดียว ไม่แก้โค้ด — fail ให้รัน `npx prettier --write .` ใน app/ แล้ว push ใหม่
    stage('Lint') {
      steps {
        dir('app') { sh 'npx -y prettier@3.3.3 --check .' }
      }
    }

    stage('Build') {
      steps {
        dir('app/fe') { sh 'npm ci && npm run build' }
        dir('app/be') { sh 'node --check server.js' }   // Node ล้วน ไม่มี build step → syntax check แทน
      }
    }

    stage('Test') {
      steps {
        dir('app/fe') { sh 'npm run test:coverage' }    // coverage/lcov.info → SonarQube
        dir('app/be') { sh 'npm test' }
      }
    }

    stage('Trivy') {
      steps { trivyScan() }                             // HIGH/CRITICAL → fail
    }

    // ปิดไว้จนกว่าจะรัน sonarqube container (docs/gui-setup.md ข้อ 5, 7)
    // stage('SonarQube') {
    //   steps {
    //     dir('app/fe') {
    //       sonarScan(projectKey: 'sample-app', sources: 'src', gate: true,
    //                 extraArgs: '-Dsonar.javascript.lcov.reportPaths=coverage/lcov.info ' +
    //                            '-Dsonar.coverage.exclusions=src/main.jsx')
    //     }
    //   }
    // }

    // GREETING จาก OpenBao → ${GREETING} ใน docker-compose.yml
    // -p ชื่อคงที่ → deploy ซ้ำ = อัปเดต container เดิม
    // ponytail: ไม่มี health check/rollback — เพิ่ม curl /api/health เมื่อใช้จริง
    stage('Deploy') {
      steps {
        withOpenBao(app: 'sample-app', env: TARGET_ENV, secrets: [
          [envVar: 'GREETING', vaultKey: 'greeting'],
        ]) {
          dir('app') { sh 'docker compose -p sample-app up -d --build --remove-orphans' }
        }
      }
    }
  }
}
